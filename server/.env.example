# Server
PORT=3000
NODE_ENV=development

# CORS - the Angular dev server origin (comma-separate multiple origins for production)
CLIENT_ORIGIN=http://localhost:4200

# Resend (https://resend.com) - leave empty in local development.
# When missing, the API logs the inquiry + generated email instead of sending it.
RESEND_API_KEY=
CONTACT_EMAIL=harel.red@gmail.com
# Use your verified domain here. Reply-To on customer confirmations uses this same address
# (do not point Reply-To at Gmail — that hurts deliverability).
EMAIL_FROM=YERUSHALMI.AI <info@yerushalmi.ai>

# Storage provider: mock | r2 | s3 | cloudinary
# mock = no real uploads (default for local dev)
# r2   = Cloudflare R2 via presigned PUT URLs (requires vars below)
STORAGE_PROVIDER=mock

# Cloudflare R2 (required when STORAGE_PROVIDER=r2)
# Create an R2 bucket + S3-compatible API token in the Cloudflare dashboard.
# R2_PUBLIC_BASE_URL = your r2.dev subdomain or custom domain with public access enabled.
# Bucket CORS must allow PUT from CLIENT_ORIGIN origins, e.g.:
#   AllowedMethods: PUT, HEAD
#   AllowedHeaders: *
#   AllowedOrigins: http://localhost:4200, https://your-production-domain
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_BASE_URL=
