# Server
PORT=3000
NODE_ENV=development

# CORS - the Angular dev server origin (comma-separate multiple origins for production)
CLIENT_ORIGIN=http://localhost:4200

# Resend (https://resend.com) - leave empty in local development.
# When missing, the API logs the inquiry + generated email instead of sending it.
RESEND_API_KEY=
CONTACT_EMAIL=harel.red@gmail.com
# Use your verified domain here. Reply-To on customer confirmations uses this same address
# (do not point Reply-To at Gmail — that hurts deliverability).
EMAIL_FROM=YERUSHALMI.AI <info@yerushalmi.ai>

# Storage provider abstraction - "mock" is the only implementation wired up in Milestone 1.
# Future values: "r2" | "s3" | "cloudinary"
STORAGE_PROVIDER=mock
